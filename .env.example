# ---- DeepSeek 模型 ----
# 只在本地 .env 中填写密钥，不要提交到 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
STAFF_API_TOKEN=

# ---- 按节点配置思考模式 ----
# 根据节点实测，默认全部关闭。复杂多步流程可手动将 SOLVER_THINKING 改为 true。
# 下面的节点开关优先于 DEEPSEEK_THINKING 全局开关。
TRIAGE_THINKING=false
SOLVER_THINKING=false
REVIEWER_THINKING=false
JUDGE_THINKING=false
GENERAL_THINKING=false
# 仅开启思考时生效，可填 low、high、max；建议先用 low。
DEEPSEEK_REASONING_EFFORT=low
THINKING_MAX_TOKENS=8192
# 按需覆盖，例如 SOLVER_REASONING_EFFORT=high。

# ---- LangSmith 链路追踪（可选）----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ecommerce_after_sales_agent
# 通常无需修改服务地址：
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
