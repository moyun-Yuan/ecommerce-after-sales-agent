---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>开始</p>]):::first
	triage(意图分流)
	solver(工具处理与 RAG)
	approval(人工审批)
	reviewer(答复审查)
	respond(最终响应)
	__end__([<p>结束</p>]):::last
	__start__ --> triage;
	approval --> reviewer;
	reviewer -.-> respond;
	reviewer -.-> solver;
	solver --> approval;
	triage -.-> respond;
	triage -.-> solver;
	respond --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
